# Copy to backend/.env, which is not committed.
POSTGRES_PASSWORD=change-me
# The public name of the server. Leave unset on a laptop.
# DOMAIN=api.example.org
# Lets every account play the daily and see the boards. For trying things out only.
# EVERYONE_IS_SUBSCRIBED=true
# Client ids a sign-in token must be made out to, comma-separated (Android and iOS clients).
# GOOGLE_CLIENT_IDS=…apps.googleusercontent.com,…apps.googleusercontent.com
# APPLE_CLIENT_IDS=com.ptk.anatomypro
